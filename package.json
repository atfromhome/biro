  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty",
    "start": "bun src/index.ts | pino-pretty",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:init": "bunx prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcrypt": "^5.1.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.15.6",
    "pino": "^9.6.0",
    "prisma": "^6.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.12",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-perfectionist": "^4.12.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma-json-types-generator": "^3.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
